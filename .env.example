# 로컬: `npx supabase start` 후 `npx supabase status`의 값을 넣는다 (.env.local)
# 운영: Vercel 환경변수에만 넣는다. SUPABASE_SECRET_KEY는 절대 NEXT_PUBLIC_으로 시작하면 안 된다
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
# 테스트(동시성 통합 테스트)용 DB 직접 연결
SUPABASE_DB_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
# 로컬에서만 true: 로그인 화면에 이메일 링크 로그인(개발용) 노출. 운영은 Google만
NEXT_PUBLIC_DEV_EMAIL_LOGIN=false
# Google 로그인 계정 선택 화면에 이 도메인 계정만 보이게 (힌트일 뿐, 가입 제한은 멤버 명단으로)
GOOGLE_HOSTED_DOMAIN=day1company.co.kr
# 카카오 책 검색 REST 키 (https://developers.kakao.com). 없으면 서점 페이지 정보만 사용
KAKAO_REST_KEY=
# Slack 봇 (scopes: chat:write, files:write, users:read, users:read.email). 봇을 공지 채널에 초대해야 한다
# 토큰이나 채널이 없거나 SLACK_DRY_RUN=true면 실제로 보내지 않고 공지 기록만 남긴다
SLACK_BOT_TOKEN=
SLACK_CHANNEL_ID=
SLACK_DRY_RUN=true
# AI 독후감 초안 (무료 등급). 둘 다 없으면 "프롬프트 복사"만 제공
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GROQ_API_KEY=
# 알림 버튼이 가리킬 사이트 주소. Vercel에서는 운영 도메인을 자동으로 쓰므로 비워 둬도 된다
SITE_URL=
# Vercel Cron이 /api/cron/daily를 부를 때 쓰는 비밀값 (Vercel 환경변수에 같은 값)
CRON_SECRET=
# 모두의 일지 → 구글 시트 (scripts/sheets/journals.gs 웹 앱 주소와 스크립트 속성 SECRET과 같은 값). 없으면 [시트에 올리기]를 숨긴다
JOURNAL_SHEET_WEBAPP_URL=
JOURNAL_SHEET_SECRET=
# 로컬 개발·E2E 전용 가짜 AI 초안 (운영에서는 무시됨)
AI_FAKE=false
